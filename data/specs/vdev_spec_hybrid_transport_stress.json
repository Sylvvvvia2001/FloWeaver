{
  "meta": {
    "spec_version": "0.1",
    "vdev_id": "vdev_hybrid_transport_stress_01",
    "name": "Hybrid Transport Stress Supervisor"
  },
  "sources": {
    "ha_core": {
      "repo_path": "data/repo_snapshot",
      "commit": "HEAD",
      "domains": ["switchbot", "tuya", "esphome"],
      "platforms": ["cover", "light", "climate", "switch", "sensor"]
    }
  },
  "vdev": {
    "entrypoint": {
      "kind": "ha_service",
      "service": {
        "domain": "floweaver",
        "name": "run_hybrid_transport_stress"
      }
    },
    "interfaces": {
      "exposed_entities": [
        {
          "entity_id": "sensor.vdev_hybrid_transport_ble_lane",
          "type": "sensor"
        },
        {
          "entity_id": "sensor.vdev_hybrid_transport_cloud_lane",
          "type": "sensor"
        },
        {
          "entity_id": "sensor.vdev_hybrid_transport_overall",
          "type": "sensor"
        }
      ],
      "state_contract": {
        "writes": [
          {
            "entity_id": "sensor.vdev_hybrid_transport_ble_lane",
            "fields": ["state"],
            "allowed_reorder": false,
            "allowed_coalesce": true
          },
          {
            "entity_id": "sensor.vdev_hybrid_transport_cloud_lane",
            "fields": ["state"],
            "allowed_reorder": false,
            "allowed_coalesce": true
          },
          {
            "entity_id": "sensor.vdev_hybrid_transport_overall",
            "fields": ["state"],
            "allowed_reorder": false,
            "allowed_coalesce": true
          }
        ]
      }
    },
    "actions": [
      {
        "action_id": "A1",
        "type": "read",
        "target": {
          "kind": "ble_device",
          "id": "ble:switchbot:curtain_lr"
        },
        "io": {
          "protocol": "BLE"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "cover",
          "service": "refresh_cover",
          "data_template": {
            "device_id": "ble:switchbot:curtain_lr",
            "lane": "ble_cluster"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true,
          "marker_hints": ["BLE_OP"]
        }
      },
      {
        "action_id": "A2",
        "type": "read",
        "target": {
          "kind": "ble_device",
          "id": "ble:esphome:air_node"
        },
        "io": {
          "protocol": "BLE"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "esphome",
          "service": "connect",
          "data_template": {
            "device_id": "ble:esphome:air_node",
            "lane": "local_transport"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true,
          "marker_hints": ["BLE_CONNECT", "BLE_OP"]
        }
      },
      {
        "action_id": "A3",
        "type": "read",
        "target": {
          "kind": "ble_device",
          "id": "ble:esphome:relay_node"
        },
        "io": {
          "protocol": "BLE"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "manager",
          "service": "subscribe",
          "data_template": {
            "device_id": "ble:esphome:relay_node",
            "lane": "local_transport"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true,
          "marker_hints": ["SUBSCRIBE", "BLE_OP"]
        }
      },
      {
        "action_id": "A4",
        "type": "call_api",
        "target": {
          "kind": "cloud_endpoint",
          "id": "tuya:light.living_room.status"
        },
        "io": {
          "protocol": "CLOUD"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "light",
          "service": "status",
          "data_template": {
            "endpoint": "tuya:light.living_room.status",
            "device_group": "cloud_lane"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true
        }
      },
      {
        "action_id": "A5",
        "type": "call_api",
        "target": {
          "kind": "cloud_endpoint",
          "id": "tuya:climate.bedroom.status"
        },
        "io": {
          "protocol": "CLOUD"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "climate",
          "service": "status",
          "data_template": {
            "endpoint": "tuya:climate.bedroom.status",
            "device_group": "cloud_lane"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true
        }
      },
      {
        "action_id": "A6",
        "type": "call_api",
        "target": {
          "kind": "cloud_endpoint",
          "id": "tuya:switch.energy_strip.status"
        },
        "io": {
          "protocol": "CLOUD"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "switch",
          "service": "status",
          "data_template": {
            "endpoint": "tuya:switch.energy_strip.status",
            "device_group": "cloud_lane"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true
        }
      },
      {
        "action_id": "A7",
        "type": "write",
        "target": {
          "kind": "ha_entity",
          "id": "sensor.vdev_hybrid_transport_ble_lane",
          "entity_id": "sensor.vdev_hybrid_transport_ble_lane"
        },
        "io": {
          "protocol": "HA"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "fan",
          "service": "publish",
          "data_template": {
            "entity_id": "sensor.vdev_hybrid_transport_ble_lane"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true,
          "side_effects": ["state_write"]
        }
      },
      {
        "action_id": "A8",
        "type": "write",
        "target": {
          "kind": "ha_entity",
          "id": "sensor.vdev_hybrid_transport_cloud_lane",
          "entity_id": "sensor.vdev_hybrid_transport_cloud_lane"
        },
        "io": {
          "protocol": "HA"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "entity",
          "service": "publish",
          "data_template": {
            "entity_id": "sensor.vdev_hybrid_transport_cloud_lane"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true,
          "side_effects": ["state_write"]
        }
      },
      {
        "action_id": "A9",
        "type": "write",
        "target": {
          "kind": "ha_entity",
          "id": "sensor.vdev_hybrid_transport_overall",
          "entity_id": "sensor.vdev_hybrid_transport_overall"
        },
        "io": {
          "protocol": "HA"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "update",
          "service": "publish",
          "data_template": {
            "entity_id": "sensor.vdev_hybrid_transport_overall"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true,
          "side_effects": ["state_write"]
        }
      }
    ],
    "dependencies": {
      "hard": [
        {
          "before": "A2",
          "after": "A3",
          "reason": "transport_connect_before_subscription"
        },
        {
          "before": "A1",
          "after": "A7",
          "reason": "ble_lane_write_depends_on_switchbot_refresh"
        },
        {
          "before": "A2",
          "after": "A7",
          "reason": "ble_lane_write_depends_on_local_connect"
        },
        {
          "before": "A3",
          "after": "A7",
          "reason": "ble_lane_write_depends_on_subscription"
        },
        {
          "before": "A4",
          "after": "A8",
          "reason": "cloud_lane_write_depends_on_light_status"
        },
        {
          "before": "A5",
          "after": "A8",
          "reason": "cloud_lane_write_depends_on_climate_status"
        },
        {
          "before": "A6",
          "after": "A8",
          "reason": "cloud_lane_write_depends_on_switch_status"
        },
        {
          "before": "A7",
          "after": "A9",
          "reason": "overall_write_depends_on_ble_lane"
        },
        {
          "before": "A8",
          "after": "A9",
          "reason": "overall_write_depends_on_cloud_lane"
        }
      ],
      "soft": [
        {
          "before": "A1",
          "after": "A2",
          "reason": "shared_radio_or_transport_budget"
        },
        {
          "before": "A1",
          "after": "A3",
          "reason": "shared_radio_or_transport_budget"
        }
      ]
    }
  },
  "objectives": {
    "primary": "minimize_tail_latency_under_mixed_transport",
    "metrics": {
      "e2e_latency_ms": {
        "p95": 2200
      },
      "lane_completion_ms": {
        "ble_lane_p95": 900,
        "cloud_lane_p95": 1400
      }
    }
  },
  "constraints": {
    "optimization_knobs": {
      "allow_concurrency": true,
      "max_concurrency": {
        "ble": 1,
        "cloud": 4,
        "total": 7
      }
    }
  },
  "validation": {
    "differential_tests": {
      "enabled": true,
      "scenarios": ["baseline_happy_path", "fault_cloud_429", "fault_ble_disconnect"],
      "runs_per_scenario": 2
    }
  }
}

{
  "meta": {
    "spec_version": "0.1",
    "vdev_id": "vdev_demo_01",
    "name": "Demo VDev"
  },
  "sources": {
    "ha_core": {
      "repo_path": "data/repo_snapshot",
      "commit": "HEAD",
      "domains": ["demo_ble", "demo_cloud"],
      "platforms": ["sensor", "switch"]
    }
  },
  "vdev": {
    "entrypoint": {
      "kind": "ha_service",
      "service": {
        "domain": "floweaver",
        "name": "run"
      }
    },
    "interfaces": {
      "exposed_entities": [
        {
          "entity_id": "sensor.vdev_x",
          "type": "sensor"
        }
      ],
      "state_contract": {
        "writes": [
          {
            "entity_id": "sensor.vdev_x",
            "fields": ["state"],
            "allowed_reorder": false,
            "allowed_coalesce": true
          }
        ]
      }
    },
    "actions": [
      {
        "action_id": "A1",
        "type": "read",
        "target": {
          "kind": "ble_device",
          "id": "ble:aa:bb:cc"
        },
        "io": {
          "protocol": "BLE"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "ble_proxy",
          "service": "read",
          "data_template": {
            "device_id": "ble:aa:bb:cc"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true
        }
      },
      {
        "action_id": "A2",
        "type": "call_api",
        "target": {
          "kind": "cloud_endpoint",
          "id": "tuya:device.control"
        },
        "io": {
          "protocol": "CLOUD"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "tuya",
          "service": "call_api",
          "data_template": {
            "endpoint": "tuya:device.control"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true
        }
      },
      {
        "action_id": "A3",
        "type": "write",
        "target": {
          "kind": "ha_entity",
          "id": "sensor.vdev_x",
          "entity_id": "sensor.vdev_x"
        },
        "io": {
          "protocol": "HA"
        },
        "exec": {
          "kind": "ha_service_call",
          "domain": "homeassistant",
          "service": "update_entity",
          "data_template": {
            "entity_id": "sensor.vdev_x"
          },
          "blocking": true
        },
        "semantics": {
          "critical": true,
          "side_effects": ["state_write"],
          "must_happen_before": []
        }
      }
    ],
    "dependencies": {
      "hard": [
        {
          "before": "A1",
          "after": "A3",
          "reason": "write_depends_on_read"
        },
        {
          "before": "A2",
          "after": "A3",
          "reason": "write_depends_on_api"
        }
      ],
      "soft": [
        {
          "before": "A1",
          "after": "A2",
          "reason": "ble_and_cloud_overlap_risk"
        }
      ]
    }
  },
  "objectives": {
    "primary": "minimize_tail_latency",
    "metrics": {
      "e2e_latency_ms": {
        "p95": 1500
      }
    }
  },
  "constraints": {
    "optimization_knobs": {
      "allow_concurrency": true,
      "max_concurrency": {
        "ble": 1,
        "cloud": 4,
        "total": 6
      }
    }
  },
  "validation": {
    "differential_tests": {
      "enabled": true,
      "scenarios": ["baseline_happy_path", "fault_cloud_429"],
      "runs_per_scenario": 3
    }
  }
}
